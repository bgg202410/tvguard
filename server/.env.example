# ------------------------------------------------------------------
# TvGuard 管理端配置
#
# 用法：把这个文件复制成同目录的 .env，然后改下面的值。
#   cp .env.example .env
#   docker compose up -d
#
# 注意：仓库里的 docker-compose.yml 目前把 PORT / TZ / ADMIN_PASSWORD
# 写成了固定值，光复制本文件不会覆盖它们。要让 .env 生效，需按 README
# 「配置」一章把 compose 对应行改成 ${ADMIN_PASSWORD} / ${HOST_PORT} 等，
# 或直接在 compose 里改那一行的值（最省事）。
#
# .env 已经被 .gitignore 忽略，密码不会进仓库；这份 .env.example 会进仓库，
# 所以这里只放占位符，不要写真实密码。
# ------------------------------------------------------------------

# 管理员登录密码（必改）。改完重启容器生效，旧浏览器需重新登录。
# 忘了也不要紧：部署目录 data/admin-password.txt 里始终留着当前生效的密码。
ADMIN_PASSWORD=ChangeMe_2026

# 宿主机端口，默认 8088。被占用时改这里（例如 8090），访问地址随之变化。
# 注意：改了端口要同步改电视端 gradle.properties 的 tvguard.serverUrl，
# 以及 docker-compose.yml 里的 PORT —— 三处不一致会导致电视静默连不上。
HOST_PORT=8088

# 时区，跨天清零、时段判断都按这个走
TZ=Asia/Shanghai

# 电视端包名（applicationId），须与 app 的 gradle.properties 中 tvguard.appId 一致。
# 不填即用服务端内置默认值；只有换包名时才需要设置。
# TV_PACKAGE=

# 管理端登录态有效期（小时），默认 12：当天有效，第二天要重新输密码。
# 这是「初始值」——后台「管理密码」卡片里可以直接改、改完立即持久化（data/config.json），
# 改过之后此项就不再生效（UI 优先）。不想进后台的人可以在这里一次性设好再部署。
# ADMIN_SESSION_HOURS=12
